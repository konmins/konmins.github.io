---
import ProjectCard from '@/components/ProjectCard.astro';
import { PROJECTS, getPlatforms } from '@/data/projects';
import BaseLayout from '@/layouts/BaseLayout.astro';

const platforms = getPlatforms();

// 置顶的排前面，其次按年份倒序
const projects = [...PROJECTS].sort((a, b) => {
	if (!!a.featured !== !!b.featured) return a.featured ? -1 : 1;
	return b.year.localeCompare(a.year);
});
---

<BaseLayout
	title="项目"
	description="自己写的 Android 应用、命令行工具、桌面工具和网页小工具，附技术栈与状态。"
>
	<div class="container">
		<header class="page-head">
			<h1 class="page-head__title">项目</h1>
			<p class="page-head__desc">
				平时捣鼓出来的一些东西。主力是 Android，但只要有需求，桌面端、命令行、浏览器里也会顺手写点工具。
			</p>
		</header>

		<div class="filter-bar" role="group" aria-label="按平台筛选">
			<button type="button" class="filter-chip" data-filter="all" aria-pressed="true">全部</button>
			{
				platforms.map((platform) => (
					<button type="button" class="filter-chip" data-filter={platform} aria-pressed="false">
						{platform}
					</button>
				))
			}
		</div>

		<div class="project-grid" data-project-grid>
			{projects.map((project) => <ProjectCard project={project} detailed />)}
		</div>

		<p class="empty-state is-hidden" data-project-empty>这个平台下暂时还没有项目。</p>
	</div>
</BaseLayout>

<script>
	const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
	const cards = [...document.querySelectorAll<HTMLElement>('[data-platform]')];
	const empty = document.querySelector<HTMLElement>('[data-project-empty]');

	function apply(filter: string) {
		let visible = 0;
		for (const card of cards) {
			const match = filter === 'all' || card.dataset.platform === filter;
			card.classList.toggle('is-hidden', !match);
			if (match) visible += 1;
		}

		for (const chip of chips) {
			chip.setAttribute('aria-pressed', String(chip.dataset.filter === filter));
		}

		empty?.classList.toggle('is-hidden', visible > 0);
	}

	for (const chip of chips) {
		chip.addEventListener('click', () => apply(chip.dataset.filter ?? 'all'));
	}
</script>
